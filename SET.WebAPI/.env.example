# Copy to SET.WebAPI/.env for local DEBUG (gitignored). Production sets these on the host.

# PostgreSQL
DEFAULT_CONNECTION=Host=localhost;Database=SET;Port=5432;Username=postgres;Password=CHANGE_ME
HOSTINGER_CONNECTION=Host=principles_database;Port=5432;Username=postgres;Password=CHANGE_ME;Database=principles;

# Google Sign-In client IDs (token audience)
GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# Already used by the API (optional locally)
# HOST_EMAIL_PASSWORD=
# AI_API_KEY=
# PRINCIPLES_SERVER_JWT_SECRET=
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_PROJECT_ID=
